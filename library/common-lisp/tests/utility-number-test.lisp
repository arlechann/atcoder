(in-package :cl-user)

(defpackage :utility-number-test
  (:use :cl :rove))
(in-package :utility-number-test)

(deftest arithmetic-helpers
  (ok (= 8 (utility.number:2* 4)))
  (ok (= 4 (utility.number:/2 9)))
  (ok (= 25 (utility.number:square 5)))
  (ok (= 125 (utility.number:cube 5)))
  (ok (= 64 (utility.number:cuber 4 #'*)))
  (ok (= 5 (utility.number:diff 3 8)))
  (ok (= 5 (utility.number:clamp 7 0 5)))
  (ok (= 0 (utility.number:clamp -2 0 5))))

(deftest pow-and-sequences
  (ok (= 1024 (utility.number:pow 2 10)))
  (ok (= 32 (utility.number:pow 2 5 :op #'* :identity 1)))
  (ok (= 15 (utility.number:triangular-number 5)))
  (ok (= 8 (utility.number:ceil-pow2 5)))
  (ok (= 8 (utility.number:ceil-pow2 8)))
  (ok (= 0 (utility.number:ceil-pow2 0)))
  (ok (= 1 (utility.number:ceil-pow2 1)))
  (ok (= 16 (utility.number:ceil-pow2 9)))
  (ok (= 11111 (utility.number:repunit 5)))
  (ok (= #b1111 (utility.number:repunit 4 2))))

(deftest predicate-and-update-macros
  (ok (utility.number:maxp 10 1 2 3))
  (ok (not (utility.number:maxp 3 1 2 3)))
  (ok (utility.number:minp -1 3 2 0))
  (ok (not (utility.number:minp 0 3 2 0)))
  (let ((x 5))
    (utility.number:maxf x 10 3)
    (ok (= 10 x)))
  (let ((x 5))
    (utility.number:minf x 10 3)
    (ok (= 3 x)))
  (let ((vec (vector 3 7 5))
        (index 0))
    (utility.number:maxf (aref vec (prog1 index (incf index))) 10 4)
    (ok (= 1 index))
    (ok (equalp #(10 7 5) vec)))
  (let ((vec (vector 3 7 5))
        (index 1))
    (utility.number:minf (aref vec (prog1 index (incf index))) 10 1)
    (ok (= 2 index))
    (ok (equalp #(3 1 5) vec))))

(deftest prodf
  (let ((value 3))
    (ok (= 12 (utility.number:prodf value 4)))
    (ok (= 12 value))
    (ok (= 3/2 (utility.number:prodf value 1/8)))
    (ok (= 3/2 value))
    (ok (= 0 (utility.number:prodf value 0)))
    (ok (= 0 value)))
  (let ((vec (vector 3 7 5))
        (index 0)
        (factor-evaluations 0))
    (ok (= -6
           (utility.number:prodf (aref vec (prog1 index (incf index)))
                                 (progn (incf factor-evaluations) -2))))
    (ok (= 1 index))
    (ok (= 1 factor-evaluations))
    (ok (equalp #(-6 7 5) vec)))
  (ok (handler-case
          (progn (macroexpand-1 '(utility.number:prodf value)) nil)
        (error () t))))

(deftest division-update-macros
  (macrolet ((check-update (operation initial divisor expected)
               `(let ((value ,initial))
                  (ok (equal (list ,expected)
                             (multiple-value-list (,operation value ,divisor))))
                  (ok (= ,expected value))))
             (check-place (operation expected)
               `(let ((vec (vector -7 9))
                      (index 0)
                      (divisor-evaluations 0))
                  (ok (= ,expected
                         (,operation (aref vec (prog1 index (incf index)))
                                     (progn (incf divisor-evaluations) 3))))
                  (ok (= 1 index))
                  (ok (= 1 divisor-evaluations))
                  (ok (equalp (vector ,expected 9) vec)))))
    (check-update utility.number:floorf 7 3 2)
    (check-update utility.number:floorf -7 3 -3)
    (check-update utility.number:floorf 7 -3 -3)
    (check-update utility.number:ceilingf 7 3 3)
    (check-update utility.number:ceilingf -7 3 -2)
    (check-update utility.number:ceilingf 7 -3 -2)
    (check-update utility.number:modf 7 3 1)
    (check-update utility.number:modf -7 3 2)
    (check-update utility.number:modf 7 -3 -2)
    (check-place utility.number:floorf -3)
    (check-place utility.number:ceilingf -2)
    (check-place utility.number:modf 2))
  (dolist (operation '(utility.number:floorf utility.number:ceilingf
                       utility.number:modf))
    (ok (handler-case
            (progn (macroexpand-1 (list operation 'value)) nil)
          (error () t)))))

(deftest bit-helpers
  (ok (= #b10101 (utility.number:logipop 0 0 2 4)))
  (ok (= 0 (utility.number:logmsb 1)))
  (ok (= 3 (utility.number:logmsb 8)))
  (ok (= 3 (utility.number:logmsb 10)))
  (ok (= -1 (utility.number:logmsb 0))))

(deftest approx-helpers
  (ok (= 1d-12 utility.number:*eps*))
  (ok (utility.number:approx= 1d0 (+ 1d0 1d-13)))
  (ok (not (utility.number:approx= 1d0 (+ 1d0 1d-6) :eps 1d-12)))
  (ok (utility.number:approx-zero-p 1d-13))
  (ok (not (utility.number:approx-zero-p 1d-6 :eps 1d-12)))
  (ok (utility.number:approx<= 1d0 (+ 1d0 1d-13)))
  (ok (utility.number:approx>= 1d0 (- 1d0 1d-13))))

(deftest range-intersection
  (ok (utility.number:range-intersect-p 1 3 3 5 :touchp t))
  (ok (not (utility.number:range-intersect-p 1 3 3 5 :touchp nil)))
  (ok (utility.number:range-intersect-p 5 1 4 2 :touchp t))
  (ok (not (utility.number:range-intersect-p 1 2 3 4 :touchp t))))
